# Copy to .env and replace every placeholder with a locally managed secret.
# Never commit .env or real credentials.
POSTGRES_USER=lcg_admin
POSTGRES_PASSWORD=replace_with_local_secret
POSTGRES_DB=link_context
RABBITMQ_USER=lcg_app
RABBITMQ_PASSWORD=replace_with_local_secret
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

REDIS_PASSWORD=replace_with_local_secret

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace_with_local_secret
KEYCLOAK_ADMIN_URL=http://localhost:8080/auth
KEYCLOAK_PUBLIC_URL=http://localhost:5173/auth
KEYCLOAK_ISSUER_URI=http://localhost:5173/auth/realms/link-context
KEYCLOAK_ISSUER_URI_DOCKER=http://localhost:5173/auth/realms/link-context
FRONTEND_PORT=5173
FRONTEND_API_BASE_URL=http://localhost:8084
FRONTEND_KEYCLOAK_URL=http://localhost:5173/auth
FRONTEND_KEYCLOAK_REALM=link-context
FRONTEND_KEYCLOAK_CLIENT_ID=link-context-web
CORS_ALLOWED_ORIGINS=http://localhost:5173
EXTRACTION_CLIENT_ID=extraction-service
EXTRACTION_CLIENT_SECRET=replace-with-keycloak-client-secret
NOTIFICATION_CLIENT_ID=link-service
NOTIFICATION_CLIENT_SECRET=replace-with-keycloak-client-secret
INTERNAL_USER_LOOKUP_CLIENT_IDS=notification-service,link-service,summarization-service
# Service client used by the grounded privacy assistant to read the user's own footprint records.
# Requires Keycloak client-credentials with the users.read scope and user-service audience.
USER_SERVICE_CLIENT_ID=summarization-service
USER_SERVICE_CLIENT_SECRET=replace-with-keycloak-client-secret

LINK_DB_URL=jdbc:postgresql://localhost:5432/link_db
LINK_DB_USERNAME=link_user
LINK_DB_PASSWORD=replace_with_local_secret
EXTRACTION_DB_URL=jdbc:postgresql://localhost:5432/extraction_db
EXTRACTION_DB_USERNAME=extraction_user
EXTRACTION_DB_PASSWORD=replace_with_local_secret
SUMMARY_DB_URL=jdbc:postgresql://localhost:5432/summary_db
SUMMARY_DB_USERNAME=summary_user
SUMMARY_DB_PASSWORD=replace_with_local_secret
USER_DB_URL=jdbc:postgresql://localhost:5432/user_db
USER_DB_USERNAME=user_user
USER_DB_PASSWORD=replace_with_local_secret
NOTIFICATION_DB_URL=jdbc:postgresql://localhost:5432/notification_db
NOTIFICATION_DB_USERNAME=notification_user
NOTIFICATION_DB_PASSWORD=replace_with_local_secret

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
GEMINI_API_KEY=replace_with_local_secret

# Tracing and alert routing
TRACING_SAMPLING_PROBABILITY=0.1
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_FROM=replace-with-alert-sender@example.invalid
ALERT_SMTP_USERNAME=replace-with-alert-sender@example.invalid
ALERT_EMAIL_TO=replace-with-alert-recipient@example.invalid
